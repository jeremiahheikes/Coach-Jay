{
  "name": "Coach Jay",
  "short_name": "Coach Jay",
  "description": "Golf coaching: progress, ball data, swing video and lessons.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#f5f4ee",
  "theme_color": "#1f4d3a",
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "video", "accept": ["video/*"] }] }
  },
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-512.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
